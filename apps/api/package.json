{
  "name": "@routecommand/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TSX_TSCONFIG_PATH=tsconfig.runtime.json node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "pretest:integration": "npm run build --workspace @routecommand/shared",
    "test:integration": "tsx --tsconfig tsconfig.runtime.json tests/integration/run.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts down",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db/check.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@routecommand/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "maxmind": "^5.1.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.7",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  }
}
