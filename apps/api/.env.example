TILE_PROVIDER_ATTRIBUTION=Tiles © Esri
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
EMAIL_FROM=RouteCommand <no-reply@routecommand.local>
EMAIL_RECIPIENT_MAX_PER_HOUR=20
EMAIL_GLOBAL_MAX_PER_HOUR=5000
EMAIL_CIRCUIT_FAILURE_THRESHOLD=10
GEOIP_DATABASE_PATH=
