NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://routecommand:routecommand@localhost:5432/routecommand
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=100000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
DRIVER_SIGNAL_STALE_SECONDS=180
PICKUP_PROXIMITY_RADIUS_M=150
PICKUP_PROXIMITY_MODE=SOFT
JWT_ACCESS_SECRET=routecommand-dev-access-secret-change-before-production
JWT_REFRESH_SECRET=routecommand-dev-refresh-secret-change-before-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAX_ACCURACY_M=100
TELEMETRY_MAX_AGE_HOURS=72
TELEMETRY_FUTURE_SKEW_SECONDS=120
TELEMETRY_RATE_LIMIT_PER_SECOND=500
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_DB_POSITION_THROTTLE_SECONDS=10
TELEMETRY_MAX_SPEED_BIKE_MPS=30
TELEMETRY_MAX_SPEED_CAR_MPS=75
TELEMETRY_MAX_SPEED_VAN_MPS=55
TELEMETRY_MAX_SPEED_TRUCK_MPS=45
TILE_PROVIDER_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
TILE_PROVIDER_ATTRIBUTION=Tiles © Esri
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RouteCommand <no-reply@routecommand.local>
GEOIP_DATABASE_PATH=
