{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@routecommand/shared": ["./packages/shared/dist/index.d.ts"],
      "@routecommand/shared/*": ["./packages/shared/dist/*"]
    }
  }
}
